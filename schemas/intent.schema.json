{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://protocol-wealth.github.io/pwcli-core/schemas/intent.schema.json",
  "title": "pwcli-core Intent Payload",
  "description": "Structured telemetry produced when lossy human input is compiled into a deterministic application intent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "domain",
    "intent",
    "confidence",
    "sideEffectLevel",
    "approvalRequired",
    "fallbackRoute",
    "candidatePanels"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.0\\.0$"
    },
    "domain": {
      "type": "string",
      "minLength": 1,
      "examples": [
        "tax",
        "archive",
        "portfolio",
        "family_ops"
      ]
    },
    "intent": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_:-]*$"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "sideEffectLevel": {
      "type": "string",
      "enum": [
        "read_only",
        "idempotent_mutation",
        "state_change"
      ]
    },
    "approvalRequired": {
      "type": "boolean"
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "fallbackRoute": {
      "type": "string",
      "pattern": "^/[A-Za-z0-9_./:-]*$"
    },
    "candidatePanels": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "clarifyingQuestions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "reasonCodes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_:-]*$"
      },
      "default": []
    },
    "rawInputRef": {
      "type": "string",
      "description": "Opaque reference to stored raw user input, if retained."
    }
  }
}
