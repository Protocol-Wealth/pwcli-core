{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://protocol-wealth.github.io/pwcli-core/schemas/context-pack.schema.json",
  "title": "pwcli-core Context Pack Frontmatter",
  "description": "YAML frontmatter shape for Markdown context files.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "title",
    "status",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "type": {
      "type": "string",
      "enum": [
        "specification_docs",
        "architecture_graph",
        "operating_context",
        "workflow_context",
        "standards_reference"
      ]
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "draft",
        "deprecated"
      ]
    },
    "version": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "sensitivity": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "private",
        "restricted"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "lastReviewed": {
      "type": "string",
      "format": "date"
    }
  }
}
