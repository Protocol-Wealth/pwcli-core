{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://protocol-wealth.github.io/pwcli-core/schemas/context-pack.schema.json",
  "title": "pwcli-core Context Pack Frontmatter",
  "description": "YAML frontmatter shape for Markdown context files.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "title",
    "status",
    "version",
    "domain",
    "maturity",
    "provenance",
    "sensitivity",
    "lastReviewed"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "type": {
      "type": "string",
      "enum": [
        "specification_docs",
        "architecture_graph",
        "operating_context",
        "workflow_context",
        "standards_reference"
      ]
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "draft",
        "deprecated"
      ]
    },
    "version": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "sensitivity": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "private",
        "restricted"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "lastReviewed": {
      "type": "string",
      "format": "date"
    },
    "domain": {
      "type": "string",
      "description": "Primary domain or layer described by this context file."
    },
    "maturity": {
      "type": "string",
      "enum": [
        "stable_standard",
        "open_protocol",
        "community_standard",
        "emerging_convention",
        "experimental",
        "local_pattern",
        "pattern_only"
      ]
    },
    "provenance": {
      "type": "string",
      "description": "Human-readable source or authorship note for the context file."
    }
  }
}
