{
  "name": "pwcli-core",
  "version": "0.1.0",
  "private": false,
  "description": "Open specification for intent-driven, dual-engine applications.",
  "license": "MIT-0 OR Apache-2.0",
  "type": "module",
  "scripts": {
    "validate": "npm run validate:spec && npm run test:python-adapter && npm run test:typescript-adapter",
    "validate:spec": "node scripts/validate.mjs",
    "test:python-adapter": "python3 -m unittest discover -s examples/claude-agent-sdk-adapters/python/tests -p 'test_*.py'",
    "test:typescript-adapter": "node --experimental-strip-types examples/claude-agent-sdk-adapters/typescript/tests/adapter.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Protocol-Wealth/pwcli-core.git"
  },
  "homepage": "https://github.com/Protocol-Wealth/pwcli-core#readme",
  "bugs": {
    "url": "https://github.com/Protocol-Wealth/pwcli-core/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "intent",
    "provenance",
    "schemas",
    "mcp",
    "openapi",
    "llms-txt"
  ]
}
