{
  "schemaRef": "../../../schemas/intent.schema.json",
  "name": "Adapter Control Triage Intent",
  "summary": "Intent telemetry for a poisoned issue triage request routed through adapter control.",
  "example": {
    "schemaVersion": "1.0.0",
    "domain": "agent_control",
    "intent": "agent_control:triage_untrusted_issue",
